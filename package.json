{
  "name": "animal-camp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "10.33.4"
  },
  "scripts": {
    "dev": "next dev -p 13000",
    "build": "next build",
    "start": "next start -p 13000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build:khelogy": "vite build --config vite.khelogy.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.469.0",
    "next": "^16.2.6",
    "phaser": "^3.90.0",
    "postgres": "^3.4.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "server-only": "^0.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@netlify/plugin-nextjs": "^5.15.5",
    "@opennextjs/cloudflare": "^1.19.10",
    "drizzle-kit": "^0.31.9",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "wrangler": "^4.86.0",
    "vite": "^6.4.1",
    "@vitejs/plugin-react": "^4.7.0"
  }
}
