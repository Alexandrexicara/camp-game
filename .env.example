# Optional PostgreSQL connection. The game can run without a database for now.
DATABASE_URL=

# Optional analytics
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional platform integration
